{
    "good_fonts": ["standard"],
    "chars": "ABCEFGHJKMNPRSTLabcdefghijkmnopqrstuvwxyz",
    "deceptor": "markov2d",
    "__comment__":"Use 'markov2d','markov','random' or a custom deceptor module name (must have the function generate_decoy(linelen,lineheight,realtext) defined).",
    "charlens":[5,6,7],
    "steps":20,

    "img_distortions":{
        "enabled":true,
        "__comment":"Post-render XOR distortions on each image captcha frame. rect/circle: float 0-1 = fraction of image height, int >= 1 = absolute pixels. Defaults: rect_min_side=h/8, circle_min_radius=h/8. point: float = fraction of total pixels (density), int = exact count. point_size = side length of square points in pixels. line_width = stroke width in pixels.",
        "rect_count":2,
        "rect_min_side":0.125,
        "circle_count":1,
        "circle_min_radius":0.125,
        "line_count":4,
        "line_width":2,
        "point_density":0.0005,
        "point_count":null,
        "point_size":2
    },

    "markov2d_settings": {
        "__comment__": "Settings for the markov2d deceptor. max_run: maximum allowed run of consecutive blank characters per generated row before a non-space char is forced, so decoys don't have long empty clumps that real ASCII-art rows never have (real rows run about 2-6).",
        "max_run": 5
    },

    "audio_engine":"audiogen",
    "gap":"50%",
    "audio_steps":20,
    "jwt_secret":"CHANGE_THIS_CHANGE_THIS_CHANGE_THIS_CHANGE_THIS",
    "onetime": true,
    "__comment___onetime": "If true, /verify_token will return valid:false for a given token after the first time it's successfully checked (replay protection).",
    "allowed_types":["legacy","image","audio"],
    "training_settings":{
        "memory":5,
        "examples":1000
    }
}
